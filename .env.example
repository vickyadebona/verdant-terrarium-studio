# Copy to .env.local (git-ignored) or run `vercel env pull .env.local` once the Neon
# database is connected to the Vercel project.

# Neon pooled connection string, used by the app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Neon direct (unpooled) connection string, used by Prisma migrations and the seed script.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Better Auth: signs session cookies. Use a different random value per environment
# (`openssl rand -base64 32`). Required on Vercel; optional locally.
BETTER_AUTH_SECRET=""
# Optional. Normally the site address comes from the request (limited to our own hosts).
# BETTER_AUTH_URL="http://localhost:3000"

# Google sign-in (Google Cloud Console → OAuth client). The button appears once both are set.
# Authorized redirect URI: https://<your-site>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
